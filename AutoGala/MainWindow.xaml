<Window x:Class="AutoGala.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala"
        xmlns:view="clr-namespace:AutoGala.views"
        xmlns:vm="clr-namespace:AutoGala.ViewModels"
        mc:Ignorable="d"
        Title="AutoGala" Height="560" Width="970">

    <!-- Main window grid -->
    <Grid Background="#F4F6F8">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Menu -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D9DEE5" BorderThickness="0,0,0,1">
            
            <Menu Padding="6,3" Background="Transparent" BorderThickness="0" FontSize="13">
               
                <MenuItem Header="_Section" Padding="10,6">
                    <MenuItem Header="_Save"
                              Command="{Binding SectionView.SaveToExcelCommand}"/>
                    <MenuItem Header="_Load"
                              Command="{Binding SectionView.LoadFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Clear List"
                              Command="{Binding SectionView.ClearSectionCommand}"/>
                    <MenuItem Header="_Delete Selected" 
                              Command="{Binding SectionView.RemoveSectionsCommand}"/>
                    <MenuItem Header="_Paste from Clipboard" 
                              Command="{Binding SectionView.PasteSectionCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Get from Gala"/>
                    <MenuItem Header="_Get from AutoCAD"/>
                </MenuItem>
                
                <MenuItem Header="_Rebar" Padding="10,6">
                    <MenuItem Header="_Save"
                              Command="{Binding RebarView.SaveToExcelCommand}"/>
                    <MenuItem Header="_Load"
                              Command="{Binding RebarView.LoadFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Clear List"
                              Command="{Binding RebarView.ClearRebarCommand}"/>
                    <MenuItem Header="_Delete Selected" 
                              Command="{Binding RebarView.RemoveRebarsCommand}"/>
                    <MenuItem Header="_Check for Duplicate Rebars"
                              Command="{Binding RebarView.CheckForDuplicatesCommand}"/>
                    <MenuItem Header="_Paste from Clipboard" 
                              Command="{Binding RebarView.PasteRebarCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Get from Gala"/>
                    <MenuItem Header="_Get from AutoCAD"/>
                </MenuItem>
                
                <MenuItem Header="_Loads" Padding="10,6">
                    <MenuItem Header="_Save"
                              Command="{Binding LoadView.SaveToExcelCommand}"/>
                    <MenuItem Header="_Load"
                              Command="{Binding LoadView.LoadFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Simple Bending"/>
                    <Separator/>
                    <MenuItem Header="_Clear List" 
                              Command="{Binding LoadView.ClearLoadCommand}"/>
                    <MenuItem Header="_Delete Selected" 
                              Command="{Binding LoadView.RemoveLoadsCommand}"/>
                    <MenuItem Header="_Delete Zero Load Cases"/>
                    <MenuItem Header="_Paste from Clipboard" 
                              Command="{Binding LoadView.PasteLoadCommand}"/>
                    <MenuItem Header="_Reverse Mx sign"/>
                    <MenuItem Header="_Reverse My sign"/>
                    <MenuItem Header="_Swap Mx and My"/>
                    <Separator/>
                    <MenuItem Header="_Set to Gala"/>
                    <MenuItem Header="_Get from Gala"/>
                
                </MenuItem>

                <MenuItem Header="_More" Padding="10,6">
                    <MenuItem Header="_Edit Toggle"
                              Command="{Binding MenuEditLoadCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Save All"
                              Command="{Binding SaveAllToExcelCommand}"/>
                    <MenuItem Header="_Load All"
                              Command="{Binding LoadAllFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Clear All" 
                              Command="{Binding ClearAllCommand}"/>
                </MenuItem>

            </Menu>
        
        </Border>
        
        <!-- Main content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Section -->
            <Border Grid.Column="0" Margin="0,0,6,0" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="Sections" FontSize="13" FontWeight="SemiBold" Foreground="#343A40"/>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding SectionView}" Margin="6"/>
                </Grid>
            </Border>
            
            <!-- Rebar -->
            <Border Grid.Column="1" Margin="6,0" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="Rebar" FontSize="13" FontWeight="SemiBold" Foreground="#343A40"/>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding RebarView}" Margin="6"/>
                </Grid>
            </Border>
            
            <!-- Loads -->
            <Border Grid.Column="2" Margin="6,0,0,0" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="Loads" FontSize="13" FontWeight="SemiBold" Foreground="#343A40"/>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding LoadView}" Margin="6"/>
                </Grid>
            </Border>
            
        </Grid>
        
    </Grid>
    
    <Window.Resources>
        
        <!-- View models -->
        <DataTemplate DataType="{x:Type vm:SectionViewModel}">
            <view:SectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RebarViewModel}">
            <view:RebarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadViewModel}">
            <view:LoadView/>
        </DataTemplate>
        
    </Window.Resources>
    
</Window>
