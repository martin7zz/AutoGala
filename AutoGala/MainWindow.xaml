<Window x:Class="AutoGala.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala"
        xmlns:view="clr-namespace:AutoGala.views"
        xmlns:vm="clr-namespace:AutoGala.ViewModels"
        mc:Ignorable="d"
        Title="AutoGala" Height="560" Width="970">

    <!-- Main window grid -->
    <Grid Background="#F4F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D9DEE5" BorderThickness="0,0,0,1">

            <Menu Padding="6,3" Background="Transparent" BorderThickness="0" FontSize="13">

                <MenuItem Header="_Section" Padding="10,6">
                    <MenuItem Header="_Save"
                              Command="{Binding SectionView.SaveToExcelCommand}"/>
                    <MenuItem Header="_Load"
                              Command="{Binding SectionView.LoadFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Clear List"
                              Command="{Binding SectionView.ClearSectionCommand}"/>
                    <MenuItem Header="_Delete Selected" 
                              Command="{Binding SectionView.RemoveSectionsCommand}"/>
                    <MenuItem Header="_Paste from Clipboard" 
                              Command="{Binding SectionView.PasteSectionCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Get from Gala"
                              Command="{Binding SectionView.GetFromGalaCommand}"/>
                    <MenuItem Header="_Get from AutoCAD"
                              Command="{Binding SectionView.GetFromAutoCADCommand}"/>
                </MenuItem>

                <MenuItem Header="_Rebar" Padding="10,6">
                    <MenuItem Header="_Save"
                              Command="{Binding RebarView.SaveToExcelCommand}"/>
                    <MenuItem Header="_Load"
                              Command="{Binding RebarView.LoadFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Clear List"
                              Command="{Binding RebarView.ClearRebarCommand}"/>
                    <MenuItem Header="_Delete Selected" 
                              Command="{Binding RebarView.RemoveRebarsCommand}"/>
                    <MenuItem Header="_Check for Duplicate Rebars"
                              Command="{Binding RebarView.CheckForDuplicatesCommand}"/>
                    <MenuItem Header="_Paste from Clipboard" 
                              Command="{Binding RebarView.PasteRebarCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Get from Gala"
                              Command="{Binding RebarView.GetFromGalaCommand}"/>
                    <MenuItem Header="_Get from AutoCAD"
                              Command="{Binding RebarView.GetFromAutoCADCommand}"/>
                </MenuItem>

                <MenuItem Header="_Loads" Padding="10,6">
                    <MenuItem Header="_Save"
                              Command="{Binding LoadView.SaveToExcelCommand}"/>
                    <MenuItem Header="_Load"
                              Command="{Binding LoadView.LoadFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Simple Bending"
                              IsCheckable="True"
                              IsChecked="{Binding LoadView.IsSimpleBending}"
                              Command="{Binding LoadView.IsSimpleBendingCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Clear List" 
                              Command="{Binding LoadView.ClearLoadCommand}"/>
                    <MenuItem Header="_Delete Selected" 
                              Command="{Binding LoadView.RemoveLoadsCommand}"/>
                    <MenuItem Header="_Delete Zero Load Cases"
                              Command="{Binding LoadView.RemoveZeroLoadCasesCommand}"/>
                    <MenuItem Header="_Paste from Clipboard" 
                              Command="{Binding LoadView.PasteLoadCommand}"/>
                    <MenuItem Header="_Reverse Mx sign"
                              Command="{Binding LoadView.ReverseMxSignCommand}"/>
                    <MenuItem Header="_Reverse My sign"
                              Command="{Binding LoadView.ReverseMySignCommand}"/>
                    <MenuItem Header="_Swap Mx and My"
                              Command="{Binding LoadView.ReverseMxAndMyCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Get from Gala"
                              Command="{Binding LoadView.GetFromGalaCommand}"/>

                </MenuItem>

                <MenuItem Header="_More" Padding="10,6">
                    <MenuItem Header="_Save All"
                              Command="{Binding SaveAllToExcelCommand}"/>
                    <MenuItem Header="_Load All"
                              Command="{Binding LoadAllFromExcelCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Clear All" 
                              Command="{Binding ClearAllCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Connect to AutoCAD" 
                              Command="{Binding ConnectToAutoCADCommand}"/>
                    <MenuItem Header="_Get all from AutoCAD" 
                              Command="{Binding GetAllFromAutoCADCommand}"/>
                </MenuItem>

            </Menu>

        </Border>

        <!--Job information-->
        <Border
        Margin="0,38,0,153"
        Padding="18"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12" Grid.RowSpan="2">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Job Title -->
                <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,20,12">

                    <TextBlock Text="JOB TITLE"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding EditJobInfoView.JobTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       Margin="0,3,0,0"/>

                </StackPanel>


                <!-- Job Number -->
                <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,20,12">

                    <TextBlock Text="JOB NUMBER"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding EditJobInfoView.JobNumber}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       Margin="0,3,0,0"/>

                </StackPanel>


                <!-- Client -->
                <StackPanel Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,20,12">

                    <TextBlock Text="CLIENT"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding EditJobInfoView.Client}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       Margin="0,3,0,0"/>

                </StackPanel>


                <!-- Edit -->
                <Button Grid.Row="0"
                Grid.Column="3"
                Grid.RowSpan="2"
                Content="Edit"
                Width="75"
                Height="34"
                Margin="5,0,10,0"
                Background="#EFF6FF"
                Foreground="#2563EB"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand"
                Command="{Binding EditJobInfoCommand}"/>


                <!-- Set Gala -->
                <Button Grid.Row="0"
                Grid.Column="4"
                Grid.RowSpan="2"
                Content="Set Gala"
                Width="95"
                Height="34"
                Background="#2563EB"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand"
                Command="{Binding SetJobInfoCommand}"/>


                <!-- Calcs By -->
                <StackPanel Grid.Row="1"
                    Grid.Column="0">

                    <TextBlock Text="CALCULATED BY"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding EditJobInfoView.CalcsBy}"
                       FontSize="14"
                       Foreground="#374151"
                       Margin="0,3,0,0"/>

                </StackPanel>


                <!-- Checked By -->
                <StackPanel Grid.Row="1"
                    Grid.Column="1">

                    <TextBlock Text="CHECKED BY"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding EditJobInfoView.CheckedBy}"
                       FontSize="14"
                       Foreground="#374151"
                       Margin="0,3,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main content -->
        <Grid Margin="12,166,12,12" Grid.RowSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Section -->
            <Border Grid.Column="0" Margin="0,0,6,0" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="Sections" FontSize="13" FontWeight="SemiBold" Foreground="#343A40"/>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding SectionView}" Margin="6"/>
                </Grid>
            </Border>

            <!-- Rebar -->
            <Border Grid.Column="1" Margin="6,0" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="Rebar" FontSize="13" FontWeight="SemiBold" Foreground="#343A40"/>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding RebarView}" Margin="6"/>
                </Grid>
            </Border>

            <!-- Loads -->
            <Border Grid.Column="2" Margin="6,0,0,0" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="Loads" FontSize="13" FontWeight="SemiBold" Foreground="#343A40"/>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding LoadView}" Margin="6"/>
                </Grid>
            </Border>

        </Grid>

    </Grid>

    <Window.Resources>

        <!-- View models -->
        <DataTemplate DataType="{x:Type vm:SectionViewModel}">
            <view:SectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RebarViewModel}">
            <view:RebarView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadViewModel}">
            <view:LoadView/>
        </DataTemplate>
    </Window.Resources>

</Window>
