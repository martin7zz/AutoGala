<Window x:Class="AutoGala.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala"
        xmlns:view="clr-namespace:AutoGala.views"
        xmlns:vm="clr-namespace:AutoGala.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="900">

    <!--main window grid-->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--menu grid-->
        <Grid Grid.Row="0">

            <Menu>

                <MenuItem Header="_Section">
                    <MenuItem Header="_Save"/>
                    <MenuItem Header="_Load"/>
                    <Separator/>
                    <MenuItem Header="_Clear List"
                              Command="{Binding SectionView.ClearListCommand}"/>
                    <MenuItem Header="_Edit List"
                              Command="{Binding SectionView.EditSectionCommand}"/>
                    <MenuItem Header="_Delete Selected"
                              Command="{Binding SectionView.RemoveSectionCommand}"/>
                    <MenuItem Header="_Paste from Clipboard"
                              Command="{Binding SectionView.PasteSectionCommand}"/>
                    <!--<MenuItem Header="_Select All"/>
                    <Separator/>
                    <MenuItem Header="_Set to Gala"/>
                    <MenuItem Header="_Get from Gala"/>
                    <MenuItem Header="_Get from AutoCAD"/>-->
                </MenuItem>

                <MenuItem Header="_Rebar">
                    <MenuItem Header="_Save"/>
                    <MenuItem Header="_Load"/>
                    <Separator/>
                    <MenuItem Header="_Clear List"
                              Command="{Binding RebarView.ClearListCommand}"/>
                    <MenuItem Header="_Edit List"
                              Command="{Binding RebarView.EditRebarCommand}"/>
                    <MenuItem Header="_Delete Selected"
                              Command="{Binding RebarView.RemoveRebarCommand}"/>
                    <!--<MenuItem Header="_Check for Duplicate Rebars"/>-->
                    <MenuItem Header="_Paste from Clipboard"
                              Command="{Binding RebarView.PasteRebarCommand}"/>
                    <!--<MenuItem Header="_Select All"/>-->
                    <!--<Separator/>
                    <MenuItem Header="_Set to Gala"/>
                    <MenuItem Header="_Get from Gala"/>
                    <MenuItem Header="_Get from AutoCAD"/>-->
                </MenuItem>

                <MenuItem Header="_Loads">
                    <MenuItem Header="_Save"/>
                    <MenuItem Header="_Load"/>
                    <Separator/>
                    <!--<MenuItem Header="_Simple Bending"/>-->
                    <!--<MenuItem Header="_Append On Paste"/>
                    <Separator/>-->
                    <MenuItem Header="_Clear List"
                              Command="{Binding LoadView.ClearListCommand}"/>
                    <MenuItem Header="_Edit List"
                              Command="{Binding LoadView.EditLoadCommand}"/>
                    <MenuItem Header="_Delete Selected"
                              Command="{Binding LoadView.RemoveLoadCommand}"/>
                    <!--<MenuItem Header="_Delete Zero Load Cases"/>-->
                    <MenuItem Header="_Paste from Clipboard"
                              Command="{Binding LoadView.PasteLoadCommand}"/>
                    <!--<MenuItem Header="_Reverse Mx sign"/>-->
                    <!--<MenuItem Header="_Reverse My sign"/>-->
                    <!--<MenuItem Header="_Swap Mx and My"/>-->
                    <!--<MenuItem Header="_Select All"/>-->
                    <!--<Separator/>-->
                    <!--<MenuItem Header="_Set to Gala"/>-->
                    <!--<MenuItem Header="_Get from Gala"/>-->

                </MenuItem>

            </Menu>

        </Grid>

        <Grid Grid.Row="1" Margin="10,31,10,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding SectionView}"/>

            <ContentControl Grid.Column="1" Content="{Binding RebarView}"/>

            <ContentControl Grid.Column="2" Content="{Binding LoadView}" />


        </Grid>
        
    </Grid>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SectionViewModel}">
            <view:SectionView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RebarViewModel}">
            <view:RebarView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LoadViewModel}">
            <view:LoadView/>
        </DataTemplate>


        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowHeight" Value="18"/>
            <Setter Property="ColumnHeaderHeight" Value="22"/>
            <Setter Property="BorderBrush" Value="#888"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDD"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
</Window>
