<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base button style -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#F3F4F6"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter
                                Property="Opacity"
                                Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Primary action -->
    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModernButtonStyle}">

        <Setter Property="Background" Value="#1fc5d1"/>
        <Setter Property="Foreground" Value="#471a24"/>
        <Setter Property="BorderBrush" Value="#1f6cd1"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6898d9"/>
                <Setter Property="BorderBrush" Value="#1f6cd1"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#164480"/>
            </Trigger>
        </Style.Triggers>

    </Style>


    <!-- Delete / destructive action -->
    <Style x:Key="DangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModernButtonStyle}">

        <Setter Property="Background" Value="#ff6385"/>
        <Setter Property="Foreground" Value="#471a24"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#a85668"/>
                <Setter Property="BorderBrush" Value="#FCA5A5"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FCA5A5"/>
            </Trigger>
        </Style.Triggers>

    </Style>


    <!-- Secondary / neutral action -->
    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModernButtonStyle}">

        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#471a24"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>

        <Style.Triggers>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter
                Property="Background"
                Value="#E5E7EB"/>
                <Setter
                Property="BorderBrush"
                Value="#9CA3AF"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter
                Property="Background"
                Value="#D1D5DB"/>
            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- Green / export / connect action -->
    <Style x:Key="SuccessButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModernButtonStyle}">

        <Setter Property="Background" Value="#32f02b"/>
        <Setter Property="Foreground" Value="#471a24"/>
        <Setter Property="BorderBrush" Value="#059669"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6af765"/>
                <Setter Property="BorderBrush" Value="#047857"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#059669"/>
            </Trigger>
        </Style.Triggers>

    </Style>
    
</ResourceDictionary>