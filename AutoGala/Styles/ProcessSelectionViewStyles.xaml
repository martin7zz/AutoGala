<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes -->

    <SolidColorBrush x:Key="ProcessSelectionAccentBrush"
                     Color="#4F46E5"/>

    <SolidColorBrush x:Key="ProcessSelectionAccentHoverBrush"
                     Color="#4338CA"/>

    <SolidColorBrush x:Key="ProcessSelectionAccentPressedBrush"
                     Color="#3730A3"/>

    <SolidColorBrush x:Key="ProcessSelectionTextBrush"
                     Color="#1F2937"/>

    <SolidColorBrush x:Key="ProcessSelectionSecondaryTextBrush"
                     Color="#6B7280"/>

    <SolidColorBrush x:Key="ProcessSelectionBorderBrush"
                     Color="#E5E7EB"/>

    <SolidColorBrush x:Key="ProcessSelectionCardBrush"
                     Color="#FFFFFF"/>


    <!-- ListBox -->

    <Style TargetType="{x:Type ListBox}">

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Padding"
                Value="0"/>

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled"/>

    </Style>


    <!-- ListBox Item -->

    <Style TargetType="{x:Type ListBoxItem}">

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>

        <Setter Property="Padding"
                Value="0"/>

        <Setter Property="Margin"
                Value="0,0,0,8"/>

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ListBoxItem}">

                    <Border x:Name="ItemBorder"
                            Background="{StaticResource ProcessSelectionCardBrush}"
                            BorderBrush="{StaticResource ProcessSelectionBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">

                        <ContentPresenter/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#FAFAFF"/>

                            <Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="#C7D2FE"/>

                        </Trigger>


                        <!-- Selected -->
                        <Trigger Property="IsSelected"
                                 Value="True">

                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#F5F3FF"/>

                            <Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource ProcessSelectionAccentBrush}"/>

                        </Trigger>


                        <!-- Disabled -->
                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ItemBorder"
                                    Property="Opacity"
                                    Value="0.5"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- Primary Button -->

    <Style x:Key="ProcessSelectionPrimaryButton"
           TargetType="{x:Type Button}">

        <Setter Property="Foreground"
                Value="White"/>

        <Setter Property="Background"
                Value="{StaticResource ProcessSelectionAccentBrush}"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Padding"
                Value="22,9"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource ProcessSelectionAccentHoverBrush}"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource ProcessSelectionAccentPressedBrush}"/>

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- Secondary Button -->

    <Style x:Key="ProcessSelectionSecondaryButton"
           TargetType="{x:Type Button}">

        <Setter Property="Foreground"
                Value="#374151"/>

        <Setter Property="Background"
                Value="#FFFFFF"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource ProcessSelectionBorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="Padding"
                Value="22,9"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#F9FAFB"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#F3F4F6"/>

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>
