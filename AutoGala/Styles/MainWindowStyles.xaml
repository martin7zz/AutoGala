<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ DataGrid ============ -->
    <Style TargetType="DataGrid">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="RowHeight" Value="24"/>
        <Setter Property="ColumnHeaderHeight" Value="28"/>
        <Setter Property="BorderBrush" Value="#D0D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EDEFF2"/>
        <Setter Property="VerticalGridLinesBrush" Value="#EDEFF2"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#30343B"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- DataGrid column headers -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F1F3F5"/>
        <Setter Property="Foreground" Value="#343A40"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderBrush" Value="#D9DEE5"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SeparatorBrush" Value="#D9DEE5"/>
    </Style>

    <!-- DataGrid rows: hover + selection -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>

            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FAFBFC"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F3F6FB"/>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DCE9FD"/>
                <Setter Property="Foreground" Value="#1F2937"/>
            </Trigger>

        </Style.Triggers>
    </Style>

    <!-- DataGrid cells: kill the default blue focus/selection box -->
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#30343B"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#1F2937"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="#F8F9FA"/>
        <Setter Property="BorderBrush" Value="#E3E6EA"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Width" Value="0"/>
        <!-- most data-entry grids don't need the row-header gutter; set Width back to Auto if you use it -->
    </Style>

    <!-- ============ GroupBox ============ -->
    <Style TargetType="GroupBox">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#343A40"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="BorderBrush" Value="#D9DEE5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Background="White"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Margin="0,8,0,0">
                            <ContentPresenter Margin="8,10,8,8"/>
                        </Border>
                        <Border Background="White" Margin="10,0,0,0" Padding="4,0" HorizontalAlignment="Left">
                            <ContentPresenter ContentSource="Header"
                                               TextElement.FontWeight="SemiBold"
                                               TextElement.Foreground="#343A40"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Menu / MenuItem ============ -->
    <Style TargetType="MenuItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#343A40"/>
        <Setter Property="Padding" Value="8,5"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#EFF6FF"/>
                <Setter Property="Foreground" Value="#2563EB"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#B3B9C2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Margin" Value="4,3"/>
    </Style>

</ResourceDictionary>