<UserControl x:Class="AutoGala.views.LoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoGala.views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <GroupBox Header="Load List Data"
          Grid.Column="2"
          Margin="0,0,10,0">

        <DataGrid x:Name="LoadGrid"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              GridLinesVisibility="All"
              IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="#"
                                Width="30"
                                Binding="{Binding Id}"/>

                <DataGridTextColumn Header="N [kn]"
                                Width="*"
                                Binding="{Binding N}"/>

                <DataGridTextColumn Header="Mx [kN.m]"
                                Width="*"
                                Binding="{Binding Mx}"/>

                <DataGridTextColumn Header="My [kN.m]"
                                Width="*"
                                Binding="{Binding My}"/>

            </DataGrid.Columns>

        </DataGrid>

    </GroupBox>
</UserControl>
