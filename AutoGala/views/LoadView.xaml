<UserControl x:Class="AutoGala.views.LoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoGala.views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <GroupBox Header="Load List Data"
          Grid.Column="2"
          Margin="0,0,10,0">

        <DockPanel>

            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Content="Add Load"
                        Grid.Column="0"
                        Command="{Binding AddLoadCommand}"
                        Height="25"
                        Margin="5"/>

                <Button Content="Delete Load"
                        Grid.Column="1"
                        Command="{Binding RemoveLoadCommand}"
                        Height="25"
                        Margin="5"/>

                <Button Content="{Binding EditButtonText}"
                        Grid.Column="2"
                        Command="{Binding EditLoadCommand}"
                        Height="25"
                        Margin="5"/>

                <Button Content="Paste Loads"
                        Grid.Column="3"
                        Command="{Binding PasteLoadCommand}"
                        Height="25"
                        Margin="5"/>
            </Grid>

            <DataGrid x:Name="LoadGrid"
                      SelectedItem="{Binding SelectedLoad}"
                      ItemsSource="{Binding Loads}"
                      CopyingRowClipboardContent="CopyingRowClipboardContent"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      GridLinesVisibility="All"
                      IsReadOnly="{Binding IsGridReadOnly}">


                <DataGrid.Columns>

                    <DataGridTextColumn Header="#"
                                        Width="30"
                                        Binding="{Binding Id}"/>

                    <DataGridTextColumn Header="N [kn]"
                                        Width="*"
                                        Binding="{Binding N}"/>

                    <DataGridTextColumn Header="Mx [kN.m]"
                                        Width="*"
                                        Binding="{Binding Mx}"/>

                    <DataGridTextColumn Header="My [kN.m]"
                                        Width="*"
                                        Binding="{Binding My}"/>

                </DataGrid.Columns>

            </DataGrid>
        
        </DockPanel>

    </GroupBox>
</UserControl>
