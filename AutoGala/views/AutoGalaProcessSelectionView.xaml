<Window x:Class="AutoGala.views.AutoGalaProcessSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala.views"
        mc:Ignorable="d"
        Title="AutoGalaProcessSelectionView" Height="450" Width="800">
    
    <Grid Margin="20">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Select a running instance"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Choose which instance of the application you want to connect to."
                       Foreground="Gray"
                       Margin="0,5,0,15"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding RunningInstances}"
                 SelectedItem="{Binding SelectedInstance}"
                 BorderBrush="#DDD"
                 BorderThickness="1">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding ProcessName}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding WindowTitle}"
                                       Foreground="Gray"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{Binding ProcessId, StringFormat=PID: {0}}"
                                       FontSize="11"
                                       Foreground="#888"/>
                        </StackPanel>

                        <Ellipse Grid.Column="1"
                                 Width="10"
                                 Height="10"
                                 Fill="#42B883"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="Select"
                Width="100"
                Height="32"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Command="{Binding SelectCommand}"/>
    </Grid>
    
</Window>
