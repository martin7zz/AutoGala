<Window x:Class="AutoGala.views.AutoGalaProcessSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala.views"
        mc:Ignorable="d"
        Title="Connect to AutoGala"
        Width="720"
        Height="500"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">
    
    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Connect to AutoGala"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ProcessSelectionTextBrush}"/>

            <TextBlock Text="Select a running instance to connect to."
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="{StaticResource ProcessSelectionSecondaryTextBrush}"/>

        </StackPanel>


        <!-- Running instances -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding RunningInstances}"
                 SelectedItem="{Binding SelectedInstance}">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- Application icon -->
                        <Border Width="40"
                                Height="40"
                                Background="#EEF2FF"
                                CornerRadius="8"
                                VerticalAlignment="Center">

                            <TextBlock Text="A"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ProcessSelectionAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <!-- Process information -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Text="{Binding ProcessName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ProcessSelectionTextBrush}"/>

                            <TextBlock Text="{Binding WindowTitle}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource ProcessSelectionSecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{Binding ProcessId, StringFormat=PID {0}}"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#9CA3AF"/>

                        </StackPanel>


                        <!-- Status -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#22C55E"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Running"
                                       Margin="6,0,0,0"
                                       FontSize="12"
                                       Foreground="#16A34A"/>

                        </StackPanel>

                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>


        <!-- Footer -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- Instance count -->
            <TextBlock Grid.Column="0"
                       Text="{Binding RunningInstances.Count, StringFormat={}{0} instance(s) found}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource ProcessSelectionSecondaryTextBrush}"/>


            <!-- Refresh -->
            <Button Grid.Column="1"
                    Content="Refresh"
                    MinWidth="90"
                    Height="36"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource ProcessSelectionSecondaryButton}"/>


            <!-- Select -->
            <Button Grid.Column="3"
                    Content="Select"
                    MinWidth="90"
                    Height="36"
                    Command="{Binding SelectCommand}"
                    Style="{StaticResource ProcessSelectionPrimaryButton}"/>

        </Grid>

    </Grid>

</Window>
