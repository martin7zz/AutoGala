<UserControl x:Class="AutoGala.views.SectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoGala.views"
             xmlns:common="clr-namespace:AutoGala.Common"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <GroupBox Header="Section List Data"
              Grid.Column="2"
              Margin="0,0,10,0">

        <DockPanel>

            <Grid DockPanel.Dock="Bottom"
                  Margin="5,8,5,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Local list editing -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Add"
                            Command="{Binding AddSectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button Content="Delete"
                            Command="{Binding RemoveSectionsCommand}"
                            Style="{StaticResource DangerButtonStyle}"/>

                    <Button Content="Paste"
                            Command="{Binding PasteSectionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <!-- External sync -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="From Gala"
                            Command="{Binding GetFromGalaCommand}"
                            Style="{StaticResource SuccessButtonStyle}"/>

                    <Button Content="To Gala"
                            Command="{Binding HookToGalaCommand}"
                            Style="{StaticResource SuccessButtonStyle}"/>

                    <Button Content="AutoCAD"
                            Command="{Binding GetFromAutoCADCommand}"
                            Style="{StaticResource SuccessButtonStyle}"/>
                </StackPanel>

            </Grid>

            <DataGrid x:Name="SectionGrid"
                      SelectedItem="{Binding SelectedSection}"
                      ItemsSource="{Binding Sections}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      CanUserSortColumns="False"
                      PreviewKeyDown="SectionGrid_PreviewKeyDown"
                      CopyingRowClipboardContent="CopyingRowClipboardContent"
                      Validation.Error="SectionGrid_ValidationError"
                      SelectionChanged="SectionGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#FAFAFA"
                      RowHeight="26">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="#"
                                        Width="30"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="X [cm]"
                                        Width="*"
                                        EditingElementStyle="{StaticResource ValidationTextBoxStyle}">

                        <DataGridTextColumn.Binding>
                            <Binding Path="X" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <common:RequiredNumberValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Y [cm]"
                                        Width="*"
                                        EditingElementStyle="{StaticResource ValidationTextBoxStyle}">

                        <DataGridTextColumn.Binding>
                            <Binding Path="Y" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <common:RequiredNumberValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                </DataGrid.Columns>

            </DataGrid>

        </DockPanel>

    </GroupBox>
</UserControl>