<UserControl x:Class="AutoGala.views.SectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoGala.views"
             xmlns:common="clr-namespace:AutoGala.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <GroupBox Header="Section List Data"
      Grid.Column="2"
      Margin="0,0,10,0">

        <DockPanel>

            <Grid DockPanel.Dock="Bottom"
                  Margin="5,8,5,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Content="Add"
                    Grid.Column="0"
                    Command="{Binding AddSectionCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>

                <Button Content="Delete"
                    Grid.Column="1"
                    Command="{Binding RemoveSectionCommand}"
                    Style="{StaticResource DangerButtonStyle}"/>

                <Button Content="{Binding EditButtonText}"
                    Grid.Column="2"
                    Command="{Binding EditSectionCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="Paste"
                    Grid.Column="3"
                    Command="{Binding PasteSectionCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="Gala"
                    Grid.Column="4"
                    Command="{Binding HookToGalaCommand}"
                    Style="{StaticResource SuccessButtonStyle}"/>
            </Grid>

            <DataGrid x:Name="SectionGrid"
                  SelectedItem="{Binding SelectedSection}"
                  ItemsSource="{Binding Sections}"
                  CanUserSortColumns="False"
                  CopyingRowClipboardContent="CopyingRowClipboardContent"
                  BeginningEdit="SectionGrid_BeginningEdit"
                  Validation.Error="SectionGrid_ValidationError"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  GridLinesVisibility="All">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="#"
                                        Width="30"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="X [cm]"
                                        Width="*"
                                        EditingElementStyle="{StaticResource ValidationTextBoxStyle}">
                        
                        <DataGridTextColumn.Binding>
                            <Binding Path="X" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <common:RequiredNumberValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>
                        
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Y [cm]"
                                        Width="*"
                                        EditingElementStyle="{StaticResource ValidationTextBoxStyle}">
                        
                        <DataGridTextColumn.Binding>
                            <Binding Path="Y" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <common:RequiredNumberValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>
                        
                    </DataGridTextColumn>

                </DataGrid.Columns>

            </DataGrid>

        </DockPanel>

    </GroupBox>
</UserControl>
