<UserControl x:Class="AutoGala.views.RebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoGala.views"
             xmlns:common="clr-namespace:AutoGala.Common"
             xmlns:converters="clr-namespace:AutoGala.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:IsInCollectionConverter x:Key="IsInCollectionConverter"/>
    </UserControl.Resources>

    <GroupBox Header="Rebar List Data"
      Grid.Column="2"
      Margin="0,0,10,0">

        <DockPanel>

            <Grid DockPanel.Dock="Bottom"
                  Margin="5,8,5,5"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Content="Add"
                    Grid.Column="0"
                    Command="{Binding AddRebarCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>

                <Button Content="Delete"
                    Grid.Column="1"
                    Command="{Binding RemoveRebarsCommand}"
                    Style="{StaticResource DangerButtonStyle}"/>

                <Button Content="Paste"
                    Grid.Column="2"
                    Command="{Binding PasteRebarCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>

                <Button Content="To Gala"
                    Grid.Column="3"
                    Command="{Binding HookToGalaCommand}"
                    Style="{StaticResource SuccessButtonStyle}"/>

                <Button Content="From Gala"
                        Grid.Column="4"
                        Command="{Binding GetFromGalaCommand}"
                        Style="{StaticResource SuccessButtonStyle}"/>
            </Grid>

            <DataGrid x:Name="RebarGrid"
                  SelectedItem="{Binding SelectedRebar}"
                  ItemsSource="{Binding Rebars}"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserSortColumns="False"
                  CopyingRowClipboardContent="CopyingRowClipboardContent"
                  SelectionChanged="RebarGrid_SelectionChanged"
                  Validation.Error="RebarGrid_ValidationError"
                  CellEditEnding="RebarGrid_CellEditEnding"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  GridLinesVisibility="All">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="#"
                                        Width="30"
                                        Binding="{Binding Id}"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Asi [cm2]"
                                        Width="*"
                                        EditingElementStyle="{StaticResource ValidationTextBoxStyle}">

                        <DataGridTextColumn.Binding>
                            <Binding Path="Area" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <common:RequiredNumberValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                    <DataGridTextColumn Header="X [cm]"
                                        Width="*"
                                        EditingElementStyle="{StaticResource ValidationTextBoxStyle}">

                        <DataGridTextColumn.Binding>
                            <Binding Path="X" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <common:RequiredNumberValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Y [cm]"
                                        Width="*"
                                        EditingElementStyle="{StaticResource ValidationTextBoxStyle}">

                        <DataGridTextColumn.Binding>
                            <Binding Path="Y" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <common:RequiredNumberValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>

                    </DataGridTextColumn>

                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource IsInCollectionConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.DuplicateRebars"
                                 RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="#ffa8a8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

            </DataGrid>

        </DockPanel>

    </GroupBox>
</UserControl>
