<Window x:Class="AutoGala.views.ClipboardErrorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala.views"
        xmlns:converters="clr-namespace:AutoGala.Converters"
        xmlns:viewmodels="clr-namespace:AutoGala.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ClipboardErrorViewModel}"
        mc:Ignorable="d"
        Title="Paste Error"
        Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
        <Style x:Key="MessageTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
        <Style x:Key="FailedRowsListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#FFF7F7"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#991B1B"/>
        </Style>
        <Style x:Key="OkButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
    </Window.Resources>
    
    <Border Margin="16"
            Padding="28" 
            Background="#FFFFFF"
            CornerRadius="14"
            BorderBrush="#E5E7EB"
            BorderThickness="1">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.12"
                              Color="#000000"/>
        </Border.Effect>
        
        <Grid MaxWidth="360">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0"
                    Width="48"
                    Height="8"
                    Margin="0,0,0,45"
                    HorizontalAlignment="Left"
                    Background="#EF4444"
                    CornerRadius="2"/>
            
            <TextBlock Grid.Row="0"
                       Style="{StaticResource MessageTextStyle}"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,20,0,19"/>
            
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding FailedRows}"
                     Visibility="{Binding HasFailedRows, Converter={StaticResource BoolToVisibleConverter}}"
                     Style="{StaticResource FailedRowsListStyle}"
                     Margin="0,0,0,10"/>
            
            <Button Grid.Row="2"
                    Content="OK"
                    Width="80"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    IsCancel="True"
                    Click="OkButton_Click"
                    Style="{StaticResource OkButtonStyle}"/>
        </Grid>
    </Border>
</Window>