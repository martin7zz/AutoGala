<Window x:Class="AutoGala.views.ScaleFactorWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala.views"
        Title="Scale factor"
        SizeToContent="Height" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        FontSize="13">

    <StackPanel Margin="20">

        <TextBlock Text="AutoCAD scale factor"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Convert all x/y values, recieved from AutoCAD to cm."
                   Foreground="#6B7280"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBox Text="{Binding ScaleFactorText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6,5"
                 BorderBrush="#D9DEE5"
                 BorderThickness="1"/>

        <TextBlock Text="{Binding ErrorMessage}"
           Foreground="#D32F2F"
           FontSize="11"
           Margin="0,4,0,0"
           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibleConverter}}"/>
        
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="14,5"
                    Margin="0,0,8,0"/>
            <Button Content="OK"
                    Command="{Binding OkCommand}"
                    Padding="14,5"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>

    </StackPanel>
</Window>