<Window x:Class="AutoGala.views.ErrorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala.views"
        xmlns:viewmodels="clr-namespace:AutoGala.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:ErrorViewModel}"
        mc:Ignorable="d"
        Title="Error"
        Height="Auto" Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">


    <Border Margin="16"
            Padding="24"
            Background="#FFFFFF"
            CornerRadius="14"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                               ShadowDepth="4"
                               Direction="270"
                               Opacity="0.15"
                               Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Icon + title row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36"
                        Background="#FEF2F2"
                        CornerRadius="18"
                        Margin="0,0,12,0">
                    <TextBlock Text="!"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#EF4444"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Something went wrong"
                           Style="{StaticResource TitleTextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message + details -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding Message}"
                           Style="{StaticResource MessageTextStyle}"
                           Margin="0,0,0,12"/>

                <ListBox ItemsSource="{Binding FailedRows}"
                         Visibility="{Binding HasFailedRows, Converter={StaticResource BoolToVisibleConverter}}"
                         Style="{StaticResource FailedRowsListStyle}"
                         MaxHeight="120"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Margin="0,0,0,4"/>
            </StackPanel>

            <!-- Footer -->
            <Button Grid.Row="2"
                    Content="OK"
                    Width="88"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"
                    IsCancel="True"
                    IsDefault="True"
                    Click="OkButton_Click"
                    Style="{StaticResource OkButtonStyle}"/>
        </Grid>
    </Border>
</Window>