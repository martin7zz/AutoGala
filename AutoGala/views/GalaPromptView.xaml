<Window x:Class="AutoGala.views.GalaPromptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala.views"
        xmlns:converters="clr-namespace:AutoGala.Converters"
        mc:Ignorable="d"
        Title="GalaPromptView"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <converters:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>

        <Style x:Key="MessageTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="WaitingTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
    </Window.Resources>

    <Border
    Padding="32"
    Background="#FFFFFF"
    CornerRadius="14"
    BorderBrush="#E5E7EB"
    BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect
            BlurRadius="18"
            ShadowDepth="3"
            Direction="270"
            Opacity="0.12"
            Color="#000000"/>
        </Border.Effect>

        <StackPanel
        MinWidth="320"
        HorizontalAlignment="Center">

            <!-- Accent -->
            <Border
            Width="48"
            Height="4"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            Background="#6366F1"
            CornerRadius="2"/>

            <TextBlock
            Style="{StaticResource MessageTextStyle}"
            Text="{Binding Message}"
            FontSize="20"
            FontWeight="SemiBold"
            TextAlignment="Center"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"/>

            <TextBlock
            Style="{StaticResource WaitingTextStyle}"
            Text="Waiting for your click..."
            Margin="0,12,0,0"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibleConverter}}"/>

        </StackPanel>
    </Border>
</Window>
