<Window x:Class="AutoGala.views.EditJobInfoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoGala.views"
        mc:Ignorable="d"
        Title="EditJobInfoView" Height="450" Width="800" ResizeMode="NoResize">
    
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Job Title:"
                   VerticalAlignment="Center"
                   Margin="5"/>

        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}"
                 Margin="5"/>


        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Job Number:"
                   VerticalAlignment="Center"
                   Margin="5"/>

        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding JobNumber}"
                 Margin="5"/>


        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Client:"
                   VerticalAlignment="Center"
                   Margin="5"/>

        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Text="{Binding Client}"
                 Margin="5"/>


        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Calcs by:"
                   VerticalAlignment="Center"
                   Margin="5"/>

        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 Text="{Binding CalcsBy}"
                 Margin="5"/>


        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Checked by:"
                   VerticalAlignment="Center"
                   Margin="5"/>

        <TextBox Grid.Row="4"
                 Grid.Column="1"
                 Text="{Binding CheckedBy}"
                 Margin="5"/>


        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="80"
                    Margin="5"
                    Click="CancelButton_Click"/>

            <Button Content="Save"
                    Width="80"
                    Margin="5"
                    IsDefault="True"
                    Command="{Binding SaveButtonCommand}"/>

        </StackPanel>
        
    </Grid>
    
</Window>
